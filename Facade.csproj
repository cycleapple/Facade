<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/14.0.1">
  <PropertyGroup>
    <Version>1.0.0.3</Version>
  </PropertyGroup>

  <PropertyGroup>
    <Author>keifufu</Author>
    <Name>Facade</Name>
    <Punchline>自訂住宅外觀與節慶裝飾。</Punchline>
    <Description>在本機變更住宅外觀、染色與住宅區節慶裝飾。進入地皮時會還原外觀，以保留原本的碰撞判定。Dalamud API 13 繁體中文（zh-TW）版本。</Description>
    <RepoUrl>https://github.com/cycleapple/Facade</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/keifufu/Facade/main/images/icon.png</IconUrl>
    <Tags>facade;housing;exterior</Tags>
  </PropertyGroup>

  <ItemGroup>
   <Content Include="data/plots.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>plots.json</TargetPath>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>
</Project>
